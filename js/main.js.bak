import './firebase.js';
import './state.js';
import './data.js';

import { sanitizeRoomId } from './utils.js';
import { renderAll, renderMainCats, updateSyncUI } from './ui.js';
import { bindStaticEvents, bindDelegatedEvents } from './events.js';
import { initFirebaseAuth, joinRoom } from './services/syncService.js';
import { subscribe } from './state/store.js';

window.addEventListener('DOMContentLoaded', async () => {
  bindStaticEvents();
  bindDelegatedEvents();

  subscribe(() => {
    renderAll();
  });

  renderMainCats();
  renderAll();
  updateSyncUI(false);

  await initFirebaseAuth();

  const params = new URLSearchParams(window.location.search);
  const room = sanitizeRoomId(params.get('room') || '');
  if (room) {
    await joinRoom(room);
  }
});